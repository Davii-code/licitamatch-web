# Origem da API.
# Em desenvolvimento, deixe vazio: o proxy do Vite redireciona /api/* para
# http://localhost:3000 e o navegador só enxerga a porta 5173, o que evita CORS.
# Em produção, informe a origem real da API — ela precisa constar em FRONTEND_URL
# no back-end, senão o navegador bloqueia as chamadas com credenciais.
VITE_API_URL=

# Exibe o campo de busca textual por termo na tela de licitações.
# Mantenha alinhado com FF_TENDER_FTS_SEARCH no back-end: com a flag ligada aqui
# e desligada lá, o campo aparece e o parâmetro é ignorado.
VITE_FF_TENDER_FTS_SEARCH=true
